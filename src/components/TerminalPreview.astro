---
import type { Language } from '../data/site';
import { content } from '../data/content';
import Icon from './Icon.astro';
interface Props {
  language: Language;
}
const { language } = Astro.props;
const t = content[language].preview;
---

<figure class="preview" aria-labelledby="preview-caption">
  <div class="preview-label">
    <span class="small-cross" aria-hidden="true">
      +
    </span>
    {t.label}
    <span class="preview-number" aria-hidden="true">
      FIG. 01
    </span>
  </div>
  <div class="terminal-shell" aria-hidden="true">
    <div class="terminal-titlebar">
      <span class="window-dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span>dgl / workspace</span>
      <Icon name="layout" size={15} />
    </div>
    <div class="terminal-host">
      <span class="status-dot"></span>
      <span>{t.host}</span>
      <span class="terminal-protocol">SSH</span>
    </div>
    <div class="terminal-workspace">
      <div class="terminal-sidebar">
        <span class="terminal-label">TMUX</span>
        <div class="tree-session">⌄ {t.session}</div>
        <div class="tree-window">└ 0: workspace</div>
        <div class="tree-pane active">
          %0 <span>agent</span>
          <span class="pane-dot"></span>
        </div>
        <div class="tree-pane">
          %1 <span>shell</span>
        </div>
        <div class="tree-pane">
          %2 <span>logs</span>
        </div>
      </div>
      <div class="terminal-panes">
        <div class="pane-top">
          <span>~/projects/my-work</span>
          <span class="pane-badge">%0</span>
        </div>
        <div class="terminal-lines">
          <p>
            <span class="prompt">❯</span> tmux attach -t dev
          </p>
          <p class="line-muted"># {t.session}</p>
          <p>
            <span class="prompt">❯</span>{' '}
            <span class="agent-command">{t.agent}</span>
          </p>
          <div class="agent-output">
            <span class="output-glyph">✳</span>
            <p>
              {t.output}
              <br />
              <span class="line-muted">~/projects/my-work</span>
            </p>
          </div>
          <p class="terminal-cursor">
            <span class="prompt">❯</span> ▊
          </p>
        </div>
        <div class="pane-lower">
          <span class="line-muted">%1 / shell</span>
          <span>
            <span class="prompt">❯</span> git status{' '}
            <span class="line-muted">— main</span>
          </span>
        </div>
      </div>
    </div>
    <div class="terminal-statusline">
      <span>
        dev <span class="line-muted">/</span> workspace
      </span>
      <span>tmux</span>
    </div>
  </div>
  <figcaption id="preview-caption">{t.caption}</figcaption>
  <div class="preview-route" aria-hidden="true">
    <span class="route-line"></span>
    {t.footer}
  </div>
</figure>
