---
import Base from '../layouts/Base.astro';
import { site, type Language, localePath } from '../data/site';
interface Props { language: Language }
const { language } = Astro.props;
---
<Base language={language} title={`${site.appName} — ${site.expansion}`} description="SSH and tmux for your personal-server AI coding workflow.">
  <header class="site-header container">
    <a href={localePath(language)}>{site.name}</a>
    <a href={localePath(language === 'en' ? 'ko' : 'en')} lang={language === 'en' ? 'ko' : 'en'}>{language === 'en' ? '한국어' : 'English'}</a>
  </header>
  <main id="main" class="container"><h1>{site.appName}</h1><p>{site.expansion}</p></main>
</Base>
