---
import Base from '../layouts/Base.astro';
import { site, downloads, type Language } from '../data/site';
import { content } from '../data/content';
import { getStarSnapshot } from '../lib/stars';
import Header from './Header.astro';
import Icon from './Icon.astro';
import TerminalPreview from './TerminalPreview.astro';
interface Props {
  language: Language;
}
const { language } = Astro.props;
const t = content[language];
const stars = await getStarSnapshot();
const stepIcons = ['server', 'terminal', 'layout', 'activity'];
const downloadIcons = { apple: 'store', google: 'play', desktop: 'desktop' };
---

<Base language={language} title={t.title} description={t.description}>
  <Header language={language} stars={stars} />
  <main id="main">
    <section id="intro" class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-cross" aria-hidden="true">
            +
          </span>
          {t.hero.eyebrow}
        </p>
        <p class="name-expansion">{site.expansion}</p>
        <h1 id="hero-title">
          <span class="app-name">
            {site.appName}{' '}
            <span class="app-abbreviation">/ {site.abbreviation}</span>
          </span>
          {t.hero.title}
          <br />
          <span class="accent">{t.hero.emphasis}</span>
        </h1>
        <p class="hero-body">{t.hero.body}</p>
        <div class="hero-actions">
          <a class="button primary" href={site.repository}>
            <Icon name="github" size={18} />
            {t.hero.github}
            <Icon name="external" size={17} />
          </a>
          <a class="button secondary" href="#get-app">
            {t.hero.getApp}
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <p class="development-note">
          <span class="status-label">
            <span class="status-dot amber"></span>
            {t.hero.status}
          </span>
          <span>{t.hero.note}</span>
        </p>
      </div>
      <TerminalPreview language={language} />
    </section>
    <nav class="section-nav container" aria-label={t.nav.label}>
      <span class="nav-prefix" aria-hidden="true">
        ~/dgl
      </span>
      <a href="#workflow">{t.nav.workflow}</a>
      <span aria-hidden="true">/</span>
      <a href="#features">{t.nav.features}</a>
      <span aria-hidden="true">/</span>
      <a href="#get-app">{t.nav.getApp}</a>
      <span aria-hidden="true">/</span>
      <a href="#faq">{t.nav.faq}</a>
    </nav>
    <section
      id="workflow"
      class="section container"
      aria-labelledby="workflow-title"
    >
      <div class="section-heading">
        <p class="eyebrow">{t.workflow.eyebrow}</p>
        <h2 id="workflow-title">{t.workflow.title}</h2>
        <p class="section-intro">{t.workflow.body}</p>
      </div>
      <ol class="connection-flow">
        {t.workflow.steps.map((step, i) => (
          <li class="flow-step">
            <div class="flow-top">
              <span class="flow-icon">
                <Icon name={stepIcons[i]} size={24} />
              </span>
              <span class="flow-number">0{i + 1}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
            <span class="flow-arrow" aria-hidden="true">
              →
            </span>
          </li>
        ))}
      </ol>
      <p class="workflow-note">
        <Icon name="terminal" size={18} />
        <span>{t.workflow.note}</span>
      </p>
    </section>
    <section
      id="features"
      class="section features-section container"
      aria-labelledby="features-title"
    >
      <div class="section-heading">
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2 id="features-title">{t.features.title}</h2>
        <p class="section-intro">{t.features.body}</p>
      </div>
      <div class="feature-grid">
        {t.features.items.map((feature, i) => (
          <article class="feature-card">
            <div class="feature-top">
              <Icon name={feature.icon} size={25} />
              <span class="feature-index" aria-hidden="true">
                0{i + 1}
              </span>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <span class="feature-tag">{feature.tag}</span>
          </article>
        ))}
      </div>
    </section>
    <section
      id="get-app"
      class="section get-app-section container"
      aria-labelledby="get-app-title"
    >
      <div class="download-panel">
        <div class="download-heading">
          <div>
            <p class="eyebrow">{t.getApp.eyebrow}</p>
            <h2 id="get-app-title">{t.getApp.title}</h2>
          </div>
          <span class="development-badge">
            <span class="status-dot amber"></span>
            {t.getApp.status}
          </span>
        </div>
        <p class="section-intro">{t.getApp.body}</p>
        <div class="download-buttons" aria-describedby="download-notice">
          {downloads.map((download) => (
            <button
              class="download-button"
              type="button"
              disabled={!download.available}
              aria-describedby="download-notice"
              data-download={download.id}
            >
              <Icon name={downloadIcons[download.id]} size={26} />
              <span>
                <strong>{download.label}</strong>
                <span>{t.getApp.unavailable}</span>
              </span>
              <span class="download-dash" aria-hidden="true">
                —
              </span>
            </button>
          ))}
        </div>
        <p class="download-notice" id="download-notice">
          {t.getApp.notice}
        </p>
        <div class="download-bottom">
          <a class="text-link" href={site.repository}>
            {t.getApp.repo}
            <Icon name="arrow" size={17} />
          </a>
          <span class="package-id">
            {t.getApp.package} <code>{site.packageId}</code>
          </span>
        </div>
      </div>
    </section>
    <section
      id="faq"
      class="section faq-section container"
      aria-labelledby="faq-title"
    >
      <div class="section-heading">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 id="faq-title">{t.faq.title}</h2>
        <p class="source-note">
          <a href={`${site.repository}#readme`}>{t.faq.source} ↗</a>
          <br />
          {t.faq.reviewed}:{' '}
          <time datetime={site.contentReviewed}>{site.contentReviewed}</time>
        </p>
      </div>
      <div class="faq-list">
        {t.faq.items.map((item) => (
          <details>
            <summary>
              {item.question}
              <span aria-hidden="true" class="faq-plus">
                +
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <footer class="site-footer container">
    <div>
      <a class="brand footer-brand" href="#intro">
        <Icon name="terminal" size={20} />
        {site.name}
      </a>
      <p>
        {site.expansion} <span aria-hidden="true">/</span> {t.footer.note}
      </p>
    </div>
    <a class="back-to-top" href="#intro">
      {t.footer.top}
    </a>
  </footer>
</Base>
